{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/local/cuda-12.4/include",
                "/usr/local/TensorRT-10.13.3.9/include",
                "${workspaceFolder}/cnpy",
                // --- 为 CUTLASS 添加的包含路径 ---
                "${workspaceFolder}/cutlass/include",
                "${workspaceFolder}/cutlass/tools/util/include",
                "${workspaceFolder}/cutlass/examples/common"
            ],
            "defines": [
                // --- 为 CUTLASS 添加的预处理器定义 ---
                "__CUDACC__",
                "__CUDACC_VER_MAJOR__=12",
                "__CUDACC_VER_MINOR__=4",
                
                // --- 关键: 已根据你的 GPU (RTX 5060 Ti, Blackwell Arch) 修改 ---
                // 900 for Hopper / Blackwell
                // 890 for Ada Lovelace (RTX 40x0)
                // 860 for Ampere (RTX 30x0)
                "__CUDA_ARCH__=900",
                "__CUDA_ARCH_FEAT_SM90_ALL__=1"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}